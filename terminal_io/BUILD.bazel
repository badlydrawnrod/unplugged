load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

COMMON_COPTS = [
    "-std=c++23",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror",
]

cc_library(
    name = "api",
    srcs = ["src/io.cpp"],
    hdrs = ["include/terminal_io/io.h"],
    strip_include_prefix = "include",
    copts = COMMON_COPTS,
    visibility = [
        "//terminal:__pkg__",
        "//terminal_io/tests:__pkg__",
        "//terminal/internal/fd_byte_source:__pkg__",
    ],
)
