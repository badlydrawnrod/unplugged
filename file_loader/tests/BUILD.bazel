load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_test(
    name = "load_tests",
    srcs = ["load_tests.cpp"],
    # GoogleTest assertion templates trigger signedness diagnostics under GCC 15.
    copts = ["-UNDEBUG", "-Wno-error=sign-compare"],
    deps = [
        "//document/types:api",
        "//file_loader:api",
        "@googletest//:gtest_main",
        "@gsl//:gsl",
    ],
)
