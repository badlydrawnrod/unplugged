load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_test(
    name = "raw_mode_tests",
    srcs = ["raw_mode_tests.cpp"],
    copts = ["-UNDEBUG"],
    deps = [
        "//terminal:api",
        "//test_support:posix_endpoints",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "input_protocol_tests",
