load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_binary(
    name = "editor",
    srcs = ["main.cpp"],
    visibility = ["//:__pkg__"],
    deps = [
        "//document:api",
        "//editor_core:api",
        "//file_loader:api",
        "//key:api",
        "//terminal:api",
    ],
)

cc_test(
    name = "editor_process_tests",
    srcs = ["tests/editor_process_tests.cpp"],
    args = ["$(rootpath :editor)"],
    data = [":editor"],
    copts = ["-UNDEBUG"],
    deps = [
        "//test_support:posix_endpoints",
        "@googletest//:gtest",
    ],
)
