load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

# Force global new/delete overrides into each isolated failure test binary.
cc_library(
    name = "allocation_failure",
    testonly = True,
    srcs = ["allocation_failure.cpp"],
    hdrs = ["allocation_failure.h"],
    alwayslink = True,
    visibility = [
        "//document/tests:__pkg__",
        "//document/internal/gap_buffer/tests:__pkg__",
        "//document/internal/line_starts/tests:__pkg__",
    ],
    deps = ["@googletest//:gtest"],
)

# Isolated POSIX pipes/PTYs are shared only by terminal boundary tests.
cc_library(
    name = "posix_endpoints",
    testonly = True,
    hdrs = ["posix_endpoints.h"],
    visibility = ["//terminal/tests:__pkg__"],
)
