    ],
)

cc_test(
    name = "gap_buffer_tests",
    srcs = ["gap_buffer_tests.cpp"],
    copts = TEST_COPTS,
    defines = select({
        ":debug_build": ["CONTRACT_EXCEPTIONS"],
        "//conditions:default": [],
    }),
    deps = [
        ":document_model_test",
