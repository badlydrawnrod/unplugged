load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

COMMON_COPTS = [
    "-std=c++23",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror",
]

# GoogleTest assertion templates trigger signedness diagnostics under GCC 15.
TEST_COPTS = COMMON_COPTS + ["-UNDEBUG", "-Wno-error=sign-compare"]

config_setting(
    name = "debug_build",
    values = {"compilation_mode": "dbg"},
)

DOCUMENT_MODEL_SRCS = [
    "document.cpp",
    "gap_buffer.cpp",
    "internal/size_limits.h",
    "line_starts.cpp",
    "logical_line_range.cpp",
    "wrapped_row_range.cpp",
]

DOCUMENT_MODEL_HDRS = [
    "document.h",
    "document_view.h",
    "dsl.h",
    "gap_buffer.h",
    "line_starts.h",
    "logical_line_range.h",
    "types.h",
    "wrapped_row_range.h",
]

cc_library(
    name = "document_model",
    visibility = ["//editor_core:__pkg__"],
    srcs = DOCUMENT_MODEL_SRCS,
    hdrs = DOCUMENT_MODEL_HDRS,
    copts = COMMON_COPTS,
    deps = ["@gsl//:gsl"],
)

cc_library(
    name = "document_model_test",
    testonly = True,
    srcs = DOCUMENT_MODEL_SRCS,
    hdrs = DOCUMENT_MODEL_HDRS,
    copts = COMMON_COPTS,
    defines = select({
        ":debug_build": ["CONTRACT_EXCEPTIONS"],
        "//conditions:default": [],
    }),
    deps = ["@gsl//:gsl"],
)

cc_library(
    name = "key",
    visibility = [
        "//editor_core:__pkg__",
        "//key_decoder:__pkg__",
    ],
    srcs = ["key.cpp"],
    hdrs = ["key.h"],
    copts = COMMON_COPTS,
)

cc_test(
    name = "key_tests",
    srcs = ["key_tests.cpp"],
    copts = TEST_COPTS,
    deps = [
        ":key",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "posix_test_endpoints",
    testonly = True,
    hdrs = ["internal/test_support/posix_endpoints.h"],
)

cc_library(
    name = "raw_mode",
    srcs = ["raw_mode.cpp"],
    hdrs = ["raw_mode.h"],
    copts = COMMON_COPTS,
)

cc_test(
    name = "raw_mode_tests",
    srcs = ["raw_mode_tests.cpp"],
    copts = COMMON_COPTS + ["-UNDEBUG"],
    deps = [
        ":raw_mode",
        ":posix_test_endpoints",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "read_key",
    srcs = ["read_key.cpp"],
    hdrs = ["read_key.h"],
    copts = COMMON_COPTS,
    deps = [
        ":key",
        "//key_decoder:api",
        "//terminal_io:api",
    ],
)

cc_library(
    name = "terminal_output",
    srcs = ["terminal.cpp"],
    hdrs = ["terminal.h"],
    copts = COMMON_COPTS,
    deps = ["//terminal_io:api"],
)

cc_test(
    name = "read_key_tests",
    srcs = ["read_key_tests.cpp"],
    copts = COMMON_COPTS + ["-UNDEBUG"],
    deps = [
        ":posix_test_endpoints",
        ":read_key",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "terminal_tests",
    linkstatic = True,
    linkopts = ["-Wl,--wrap=sigaction"],
    srcs = ["terminal_tests.cpp"],
    copts = COMMON_COPTS + ["-UNDEBUG"],
    deps = [
        ":posix_test_endpoints",
        ":terminal_output",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "editor_support",
    srcs = [
        "gap_loader.cpp",
        "input_protocol.cpp",
    ],
    hdrs = [
        "gap_loader.h",
        "input_protocol.h",
    ],
    copts = COMMON_COPTS,
    deps = [
        ":document_model",
        ":terminal_output",
        "//terminal_io:api",
        "@gsl//:gsl",
    ],
)

cc_binary(
    name = "editor",
    srcs = ["editor.cpp"],
    copts = COMMON_COPTS,
    deps = [
        ":document_model",
        ":editor_support",
        ":raw_mode",
        ":read_key",
        ":terminal_output",
        "//editor_core:api",
        "@gsl//:gsl",
    ],
)

cc_test(
    name = "size_limits_tests",
    srcs = [
        "internal/size_limits.h",
        "internal/size_limits_tests.cpp",
        "types.h",
    ],
    copts = TEST_COPTS,
    deps = [
        "@googletest//:gtest_main",
    ],
)

