cc_test(
    name = "document_tests",
    srcs = ["document_tests.cpp"],
    copts = TEST_COPTS,
    defines = select({
        ":debug_build": ["CONTRACT_EXCEPTIONS"],
        "//conditions:default": [],
    }),
    deps = [
        ":document_model_test",
