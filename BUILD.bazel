load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

config_setting(
    name = "debug_build",
    values = {"compilation_mode": "dbg"},
)

# One transitive policy keeps test inline definitions and noexcept consistent
# across document, storage, and their consumers.
cc_library(
    name = "contract_test_mode",
    testonly = True,
    visibility = [
        "//document:__pkg__",
        "//document/internal/gap_buffer:__pkg__",
        "//document/internal/line_starts:__pkg__",
    ],
    defines = select({
        ":debug_build": ["CONTRACT_EXCEPTIONS"],
        "//conditions:default": [],
    }),
)

# Preserve existing build/run commands without exporting application internals.
alias(
    name = "editor",
    actual = "//applications/editor:editor",
)
