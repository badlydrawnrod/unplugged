load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

COMMON_COPTS = [
    "-std=c++23",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror",
]

# GoogleTest assertion templates trigger signedness diagnostics under GCC 15.
TEST_COPTS = COMMON_COPTS + ["-UNDEBUG", "-Wno-error=sign-compare"]

config_setting(
    name = "debug_build",
    values = {"compilation_mode": "dbg"},
)

# Transitional storage aggregate; the document package owns the supported API.
# Split these primitives into internal subcomponent APIs in the next increment.
DOCUMENT_STORAGE_SRCS = [
    "gap_buffer.cpp",
    "internal/size_limits.h",
    "line_starts.cpp",
]

DOCUMENT_STORAGE_HDRS = [
    "dsl.h",
    "gap_buffer.h",
    "line_starts.h",
    "types.h",
]

cc_library(
    name = "document_storage",
    visibility = ["//document:__pkg__"],
    srcs = DOCUMENT_STORAGE_SRCS,
    hdrs = DOCUMENT_STORAGE_HDRS,
    copts = COMMON_COPTS,
    deps = ["@gsl//:gsl"],
)

# Propagate the contract mode to every test translation unit and dependent
# document implementation, so inline definitions and noexcept agree.
cc_library(
    name = "document_storage_test",
    testonly = True,
    visibility = ["//document:__pkg__"],
    srcs = DOCUMENT_STORAGE_SRCS,
    hdrs = DOCUMENT_STORAGE_HDRS,
    copts = COMMON_COPTS,
    defines = select({
        ":debug_build": ["CONTRACT_EXCEPTIONS"],
        "//conditions:default": [],
    }),
    deps = ["@gsl//:gsl"],
)

cc_library(
    name = "key",
    visibility = [
        "//editor_core:__pkg__",
        "//key_decoder:__pkg__",
    ],
    srcs = ["key.cpp"],
    hdrs = ["key.h"],
    copts = COMMON_COPTS,
)

cc_test(
    name = "key_tests",
    srcs = ["key_tests.cpp"],
    copts = TEST_COPTS,
    deps = [
        ":key",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "posix_test_endpoints",
    testonly = True,
    hdrs = ["internal/test_support/posix_endpoints.h"],
)

cc_library(
    name = "raw_mode",
    srcs = ["raw_mode.cpp"],
    hdrs = ["raw_mode.h"],
    copts = COMMON_COPTS,
)

cc_test(
    name = "raw_mode_tests",
    srcs = ["raw_mode_tests.cpp"],
    copts = COMMON_COPTS + ["-UNDEBUG"],
    deps = [
        ":raw_mode",
        ":posix_test_endpoints",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "read_key",
    srcs = ["read_key.cpp"],
    hdrs = ["read_key.h"],
    copts = COMMON_COPTS,
    deps = [
        ":key",
        "//key_decoder:api",
        "//terminal_io:api",
    ],
)

cc_library(
    name = "terminal_output",
    srcs = ["terminal.cpp"],
    hdrs = ["terminal.h"],
    copts = COMMON_COPTS,
    deps = ["//terminal_io:api"],
)

cc_test(
    name = "read_key_tests",
    srcs = ["read_key_tests.cpp"],
    copts = COMMON_COPTS + ["-UNDEBUG"],
    deps = [
        ":posix_test_endpoints",
        ":read_key",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "terminal_tests",
    linkstatic = True,
    linkopts = ["-Wl,--wrap=sigaction"],
    srcs = ["terminal_tests.cpp"],
    copts = COMMON_COPTS + ["-UNDEBUG"],
    deps = [
        ":posix_test_endpoints",
        ":terminal_output",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "input_protocol",
    srcs = ["input_protocol.cpp"],
    hdrs = ["input_protocol.h"],
    copts = COMMON_COPTS,
    deps = [":terminal_output"],
)

cc_test(
    name = "input_protocol_tests",
    srcs = ["input_protocol_tests.cpp"],
    copts = COMMON_COPTS + ["-UNDEBUG"],
    deps = [
        ":input_protocol",
        ":posix_test_endpoints",
        ":terminal_output",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "editor_support",
    srcs = [
        "gap_loader.cpp",
    ],
    hdrs = [
        "gap_loader.h",
    ],
    copts = COMMON_COPTS,
    deps = [
        ":document_storage",
        "@gsl//:gsl",
    ],
)

cc_binary(
    name = "editor",
    srcs = ["editor.cpp"],
    copts = COMMON_COPTS,
    deps = [
        "//document:api",
        ":editor_support",
        ":input_protocol",
        ":raw_mode",
        ":read_key",
        ":terminal_output",
        "//editor_core:api",
    ],
)

cc_test(
    name = "size_limits_tests",
    srcs = [
        "internal/size_limits.h",
        "internal/size_limits_tests.cpp",
        "types.h",
    ],
    copts = TEST_COPTS,
    deps = [
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "gap_loader_tests",
    srcs = ["gap_loader_tests.cpp"],
    copts = TEST_COPTS,
    deps = [
        ":editor_support",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "gap_buffer_tests",
    srcs = ["gap_buffer_tests.cpp"],
    copts = TEST_COPTS,
    defines = select({
        ":debug_build": ["CONTRACT_EXCEPTIONS"],
        "//conditions:default": [],
    }),
    deps = [
        ":document_storage_test",
        "@googletest//:gtest_main",
        "@gsl//:gsl",
    ],
)

cc_test(
    name = "line_starts_tests",
    srcs = ["line_starts_tests.cpp"],
    copts = TEST_COPTS,
    defines = select({
        ":debug_build": ["CONTRACT_EXCEPTIONS"],
        "//conditions:default": [],
    }),
    deps = [
        ":document_storage_test",
        "@googletest//:gtest_main",
        "@gsl//:gsl",
    ],
)

cc_test(
    name = "edit_failure_tests",
    srcs = [
        "edit_failure_tests.cpp",
        "internal/test_support/allocation_failure.cpp",
        "internal/test_support/allocation_failure.h",
    ],
    copts = TEST_COPTS,
    deps = [
        ":document_storage_test",
        "//document:test_api",
        "@googletest//:gtest_main",
    ],
)
