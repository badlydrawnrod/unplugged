load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_test(
    name = "editor_tests",
    srcs = ["editor_tests.cpp"],
    # GoogleTest assertion templates trigger signedness diagnostics under GCC 15.
    copts = ["-UNDEBUG", "-Wno-error=sign-compare"],
    deps = [
        "//document:api",
        "//editor_core:api",
        "@googletest//:gtest_main",
    ],
)
