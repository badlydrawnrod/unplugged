load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

COMMON_COPTS = [
    "-std=c++23",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror",
]

cc_library(
    name = "storage",
    srcs = ["line_starts.cpp"],
    hdrs = ["line_starts.h"],
    copts = COMMON_COPTS,
    deps = [
        "//document/internal/size_limits:api",
        "//contracts:checks",
        "//document:line_starts_layout",
    ],
)

alias(
    name = "api",
    actual = ":storage",
    visibility = [
        "//document:__pkg__",
    ],
)

# Same supported API with the shared debug-only throwing contract policy.
cc_library(
    name = "storage_test",
    testonly = True,
    srcs = ["line_starts.cpp"],
    hdrs = ["line_starts.h"],
    copts = COMMON_COPTS,
    deps = [
        "//:contract_test_mode",
        "//document/internal/size_limits:api",
        "//contracts:checks",
        "//document:line_starts_layout",
    ],
)

alias(
    name = "test_api",
    actual = ":storage_test",
    testonly = True,
    visibility = [
        "//document:__pkg__",
    ],
)

# GoogleTest assertion templates trigger signedness diagnostics under GCC 15.
cc_test(
    name = "line_starts_tests",
    srcs = ["line_starts_tests.cpp"],
    copts = COMMON_COPTS + ["-UNDEBUG", "-Wno-error=sign-compare"],
    deps = [
        ":test_api",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "edit_failure_tests",
    srcs = ["edit_failure_tests.cpp"],
    linkstatic = True,
    copts = COMMON_COPTS + ["-UNDEBUG", "-Wno-error=sign-compare"],
    deps = [
        ":test_api",
        "//test_support:allocation_failure",
        "@googletest//:gtest_main",
    ],
)
