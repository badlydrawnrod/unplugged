load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "api",
    srcs = ["line_starts.cpp"],
    hdrs = ["line_starts.h"],
    visibility = ["//document:__pkg__"],
    deps = [
        "//contracts:api",
        "//contracts:checks",
        "//document/internal/size_limits:api",
        "//document/types:api",
    ],
)

# Same supported API with the shared debug-only throwing contract policy.
cc_library(
    name = "test_api",
    testonly = True,
    srcs = ["line_starts.cpp"],
    hdrs = ["line_starts.h"],
    visibility = [
        "//document:__pkg__",
        "//document/internal/line_starts/tests:__pkg__",
    ],
    deps = [
        "//:contract_test_mode",
        "//contracts:api",
        "//contracts:checks",
        "//document/internal/size_limits:api",
        "//document/types:api",
    ],
)
