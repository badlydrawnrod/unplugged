load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

COMMON_COPTS = [
    "-std=c++23",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror",
]

cc_library(
    name = "storage",
    srcs = ["line_starts.cpp"],
    hdrs = ["line_starts.h"],
    copts = COMMON_COPTS,
    deps = [
        "//document/internal/size_limits:api",
        "//contracts:checks",
        "//document:line_starts_layout",
    ],
)

alias(
    name = "api",
    actual = ":storage",
    visibility = [
        "//document:__pkg__",
    ],
)

# Same supported API with the shared debug-only throwing contract policy.
cc_library(
    name = "storage_test",
    testonly = True,
    srcs = ["line_starts.cpp"],
    hdrs = ["line_starts.h"],
    copts = COMMON_COPTS,
    deps = [
        "//:contract_test_mode",
        "//document/internal/size_limits:api",
        "//contracts:checks",
        "//document:line_starts_layout",
    ],
)

alias(
    name = "test_api",
    actual = ":storage_test",
    testonly = True,
    visibility = [
        "//document:__pkg__",
        "//document/internal/line_starts/tests:__pkg__",
    ],
)
