load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "api",
    hdrs = ["size_limits.h"],
    visibility = [
        "//document:__pkg__",
        "//document/internal/gap_buffer:__pkg__",
        "//document/internal/line_starts:__pkg__",
    ],
    deps = ["//document/types:api"],
)

cc_test(
    name = "size_limits_tests",
    srcs = ["size_limits_tests.cpp"],
    # GoogleTest assertion templates trigger signedness diagnostics under GCC 15.
    copts = ["-std=c++23", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-UNDEBUG", "-Wno-error=sign-compare"],
    deps = [
        ":api",
        "@googletest//:gtest_main",
    ],
)
