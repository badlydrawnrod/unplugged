load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

COMMON_COPTS = [
    "-std=c++23",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror",
]

DOCUMENT_SRCS = [
    "src/document.cpp",
    "src/logical_line_range.cpp",
    "src/wrapped_row_range.cpp",
]

DOCUMENT_HDRS = [
    "include/document/document.h",
    "include/document/document_view.h",
    "include/document/line_number.h",
    "include/document/logical_line_range.h",
    "include/document/wrapped_row_range.h",
]

# Complete member declarations keep storage inline without exposing the
# supported internal storage APIs. Only owning implementations depend here.
cc_library(
    name = "gap_buffer_layout",
    hdrs = ["detail/gap_buffer.h"],
    visibility = ["//document/internal/gap_buffer:__pkg__"],
    deps = [
        "//document/types:api",
        "//contracts:api",
    ],
)

cc_library(
    name = "line_starts_layout",
    hdrs = ["detail/line_starts.h"],
    visibility = ["//document/internal/line_starts:__pkg__"],
    deps = [
        "//document/types:api",
        "//contracts:api",
    ],
)

cc_library(
    name = "api",
    srcs = DOCUMENT_SRCS,
    hdrs = DOCUMENT_HDRS,
    strip_include_prefix = "include",
    copts = COMMON_COPTS,
    visibility = [
        "//applications/editor:__pkg__",
        "//editor_core:__pkg__",
        "//editor_core/tests:__pkg__",
    ],
    deps = [
        ":gap_buffer_layout",
        ":line_starts_layout",
        "//document/types:api",
        "//document/internal/size_limits:api",
        "//contracts:checks",
        "//document/internal/gap_buffer:api",
        "//document/internal/line_starts:api",
    ],
)

# Supported API with the existing debug-only throwing contract policy. The
# shared policy target propagates it through all translation units.
cc_library(
    name = "test_api",
    visibility = ["//document/tests:__pkg__"],
    testonly = True,
    srcs = DOCUMENT_SRCS,
    hdrs = DOCUMENT_HDRS,
    strip_include_prefix = "include",
    copts = COMMON_COPTS,
    deps = [
        ":gap_buffer_layout",
        ":line_starts_layout",
        "//:contract_test_mode",
        "//document/types:api",
        "//document/internal/size_limits:api",
        "//contracts:checks",
        "//document/internal/gap_buffer:test_api",
        "//document/internal/line_starts:test_api",
    ],
)
