load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

DOCUMENT_SRCS = [
    "document.cpp",
    "logical_line_range.cpp",
    "wrapped_row_range.cpp",
]

DOCUMENT_HDRS = [
    "include/document/document.h",
    "include/document/document_view.h",
    "include/document/line_number.h",
    "include/document/logical_line_range.h",
    "include/document/wrapped_row_range.h",
]

cc_library(
    name = "api",
    srcs = DOCUMENT_SRCS,
    hdrs = DOCUMENT_HDRS,
    strip_include_prefix = "include",
    visibility = [
        "//applications/editor:__pkg__",
        "//editor_core:__pkg__",
        "//editor_core/tests:__pkg__",
    ],
    deps = [
        "//contracts:api",
        "//document/types:api",
        "//document/internal/size_limits:api",
        "//contracts:checks",
        "//document/internal/gap_buffer:api",
        "//document/internal/line_starts:api",
    ],
)

# Supported API with the existing debug-only throwing contract policy. The
# shared policy target propagates it through all translation units.
cc_library(
    name = "test_api",
    visibility = ["//document/tests:__pkg__"],
    testonly = True,
    srcs = DOCUMENT_SRCS,
    hdrs = DOCUMENT_HDRS,
    strip_include_prefix = "include",
    deps = [
        "//:contract_test_mode",
        "//contracts:api",
        "//document/types:api",
        "//document/internal/size_limits:api",
        "//contracts:checks",
        "//document/internal/gap_buffer:test_api",
        "//document/internal/line_starts:test_api",
    ],
)
