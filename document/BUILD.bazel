load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

COMMON_COPTS = [
    "-std=c++23",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror",
]

DOCUMENT_SRCS = [
    "document.cpp",
    "logical_line_range.cpp",
    "wrapped_row_range.cpp",
]

DOCUMENT_HDRS = [
    "document.h",
    "document_view.h",
    "line_number.h",
    "logical_line_range.h",
    "wrapped_row_range.h",
]

# Complete member declarations keep storage inline without exposing the
# supported internal storage APIs. Only owning implementations depend here.
cc_library(
    name = "gap_buffer_layout",
    hdrs = ["detail/gap_buffer.h"],
    visibility = ["//document/internal/gap_buffer:__pkg__"],
    deps = [
        "//document/types:api",
        "//contracts:api",
    ],
)

cc_library(
    name = "line_starts_layout",
    hdrs = ["detail/line_starts.h"],
    visibility = ["//document/internal/line_starts:__pkg__"],
    deps = [
        "//document/types:api",
        "//contracts:api",
    ],
)

cc_library(
    name = "api",
    srcs = DOCUMENT_SRCS,
    hdrs = DOCUMENT_HDRS,
    copts = COMMON_COPTS,
    visibility = [
        "//:__pkg__",
        "//editor_core:__pkg__",
    ],
    deps = [
        ":gap_buffer_layout",
        ":line_starts_layout",
        "//document/types:api",
        "//:size_limits",
        "//contracts:checks",
        "//document/internal/gap_buffer:api",
        "//document/internal/line_starts:api",
    ],
)

# Supported API with the existing debug-only throwing contract policy. The
# shared policy target propagates it through all translation units.
cc_library(
    name = "test_api",
    testonly = True,
    srcs = DOCUMENT_SRCS,
    hdrs = DOCUMENT_HDRS,
    copts = COMMON_COPTS,
    deps = [
        ":gap_buffer_layout",
        ":line_starts_layout",
        "//:contract_test_mode",
        "//document/types:api",
        "//:size_limits",
        "//contracts:checks",
        "//document/internal/gap_buffer:test_api",
        "//document/internal/line_starts:test_api",
    ],
)

# GoogleTest assertion templates trigger signedness diagnostics under GCC 15.
TEST_COPTS = COMMON_COPTS + ["-UNDEBUG", "-Wno-error=sign-compare"]

cc_test(
    name = "document_tests",
    srcs = [
        "document_tests.cpp",
        "public_headers_compile_test.cpp",
    ],
    copts = TEST_COPTS,
    deps = [
        ":test_api",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "document_view_tests",
    srcs = ["document_view_tests.cpp"],
    copts = TEST_COPTS,
    deps = [
        ":test_api",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "logical_line_range_tests",
    srcs = ["logical_line_range_tests.cpp"],
    copts = TEST_COPTS,
    deps = [
        ":test_api",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "wrapped_row_range_tests",
    srcs = ["wrapped_row_range_tests.cpp"],
    copts = TEST_COPTS,
    deps = [
        ":test_api",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "edit_failure_tests",
    srcs = ["edit_failure_tests.cpp"],
    linkstatic = True,
    copts = TEST_COPTS,
    deps = [
        ":test_api",
        "//test_support:allocation_failure",
        "@googletest//:gtest_main",
    ],
)
